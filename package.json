{
  "name": "causal-education-academy",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "contracts",
    "integrations/learning",
    "integrations/messaging"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "node scripts/migrate.ts",
    "db:seed": "node scripts/seed-dev.ts",
    "dev:api": "npm run dev -w @academy/api",
    "dev:web": "npm run dev -w @academy/web",
    "build:web": "npm run build -w @academy/web",
    "contracts:generate": "npm run generate -w @academy/contracts",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "@vitejs/plugin-react": "^6.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^27.0.0",
    "pg": "^8.16.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
